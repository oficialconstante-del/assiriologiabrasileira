    async function fetchDoiMetadata() {
      const raw = (document.getElementById('ref-doi-input')?.value || '').trim();
      const doi = raw.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').trim();
      if (!doi) { showToast('Informe um DOI válido (ex.: 10.1086/714678).'); return; }
      const btn = document.getElementById('doi-fetch-btn');
      if (btn) btn.textContent = 'Buscando...';
      try {
        const res = await fetch(`https://api.crossref.org/works/${encodeURIComponent(doi)}`);
        if (!res.ok) throw new Error('DOI não encontrado');
        const json = await res.json();
        const m = json.message;
        const authors = (m.author || []).map(a => `${(a.family || '').toUpperCase()}, ${a.given || ''}`).join('; ') || 'AUTOR';
        const year = m.published?.['date-parts']?.[0]?.[0] || m.created?.['date-parts']?.[0]?.[0] || '';
        state.refForm.doi = doi;
        state.refForm.tipo = m.type === 'book' ? 'livro' : (m.type === 'book-chapter' ? 'capitulo' : 'artigo');
        state.refForm.autores = authors;
        state.refForm.titulo = (m.title && m.title[0]) || '';
        state.refForm.ano = String(year);
        state.refForm.editora = (m['container-title'] && m['container-title'][0]) || m.publisher || '';
        state.refForm.volume = m.volume || '';
        state.refForm.numero = m.issue || '';
        state.refForm.paginas = m.page || '';
        renderCurrentView();
        showToast('Metadados importados via CrossRef!');
      } catch (err) {
        showToast('Não foi possível obter o DOI (verifique o código ou a conexão).');
        if (btn) btn.textContent = 'Buscar por DOI';
      }
    }

    function updateRefOutputs() {
      const r = state.refForm;
      const abntEl = document.getElementById('out-abnt');
      const chiEl = document.getElementById('out-chicago');
      const bibEl = document.getElementById('out-bibtex');
      if (!abntEl || !chiEl || !bibEl) return;

      let abnt = '', chicago = '', bibType = 'misc';
      const doiStr = r.doi ? ` DOI: https://doi.org/${r.doi}.` : '';

      if (r.tipo === 'artigo') {
        bibType = 'article';
        abnt = `${esc(r.autores)}. ${esc(r.titulo)}. <strong>${esc(r.editora)}</strong>, ${esc(r.local)}, v. ${esc(r.volume)}, n. ${esc(r.numero)}, p. ${esc(r.paginas)}, ${esc(r.ano)}.${esc(doiStr)}`;
        chicago = `${esc(r.autores)}. "${esc(r.titulo)}." <em>${esc(r.editora)}</em> ${esc(r.volume)}, no. ${esc(r.numero)} (${esc(r.ano)}): ${esc(r.paginas)}.${esc(doiStr)}`;
      } else if (r.tipo === 'livro') {
        bibType = 'book';
        abnt = `${esc(r.autores)}. <strong>${esc(r.titulo)}</strong>. ${esc(r.local)}: ${esc(r.editora)}, ${esc(r.ano)}.`;
        chicago = `${esc(r.autores)}. <em>${esc(r.titulo)}</em>. ${esc(r.local)}: ${esc(r.editora)}, ${esc(r.ano)}.`;
      } else if (r.tipo === 'capitulo') {
        bibType = 'incollection';
        abnt = `${esc(r.autores)}. ${esc(r.titulo)}. In: ${esc(r.org || 'ORG.')}. <strong>${esc(r.livroTitulo || 'Título da obra')}</strong>. ${esc(r.local)}: ${esc(r.editora)}, ${esc(r.ano)}. p. ${esc(r.paginas)}.`;
        chicago = `${esc(r.autores)}. "${esc(r.titulo)}." In <em>${esc(r.livroTitulo || 'Título da obra')}</em>, edited by ${esc(r.org || 'Org.')}, ${esc(r.paginas)}. ${esc(r.local)}: ${esc(r.editora)}, ${esc(r.ano)}.`;
      } else if (r.tipo === 'academico') {
        bibType = 'phdthesis';
        abnt = `${esc(r.autores)}. <strong>${esc(r.titulo)}</strong>. ${esc(r.ano)}. ${esc(r.grau)} — ${esc(r.instituicao)}, ${esc(r.local)}, ${esc(r.ano)}.`;
        chicago = `${esc(r.autores)}. "${esc(r.titulo)}." ${esc(r.grau)}, ${esc(r.instituicao)}, ${esc(r.ano)}.`;
      } else {
        bibType = 'misc';
        abnt = `<strong>${esc(r.siglaFonte)}</strong>. ${esc(r.titulo)}. Acervo: ${esc(r.museu)}. Edição/referência: ${esc(r.autores)}, ${esc(r.ano)}.`;
        chicago = `${esc(r.siglaFonte)}, "${esc(r.titulo)}," ${esc(r.museu)} (ed. ${esc(r.autores)}, ${esc(r.ano)}).`;
      }

      const key = (r.autores.split(',')[0] || 'ref').toLowerCase().replace(/[^a-z]/g, '') + (r.ano || '2026');
      const bib = `@${bibType}{${key},\n  author = {${r.autores}},\n  title = {${r.titulo}},\n  year = {${r.ano}},\n  publisher = {${r.editora || r.instituicao || r.museu}}${r.doi ? `,\n  doi = {${r.doi}}` : ''}\n}`;

      abntEl.innerHTML = abnt;
      chiEl.innerHTML = chicago;
      bibEl.textContent = bib;
    }

