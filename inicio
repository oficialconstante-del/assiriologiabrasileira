              <p class="text-xs text-archival-muted">Cole trechos extraídos de OCR com falhas de diacríticos (ex.: <code>s^</code>, <code>h_</code>, <code>s.</code>, <code>t.</code>) ou hifens quebrados e corrija em 1 clique.</p>
              <textarea id="ocr-input" rows="4" placeholder="Cole aqui o texto bruto do OCR (ex.: As^s^urbanipal e H_ammurapi na Babilo-\nnia antiga)..." class="w-full p-3 rounded-xl bg-archival-canvas border border-archival-border text-xs font-philology"></textarea>
              <div class="flex flex-wrap gap-2">
                <button onclick="runOcrPostProcess()" class="px-4 py-2 rounded-xl bg-lapis hover:bg-lapis-hover text-white text-xs font-semibold transition">Corrigir Diacríticos &amp; Espaços</button>
                <button onclick="copyById('ocr-output', 'Texto corrigido copiado!')" class="px-4 py-2 rounded-xl bg-archival-terracotta text-white text-xs font-semibold transition">Copiar Resultado</button>
              </div>
              <textarea id="ocr-output" rows="4" readonly placeholder="O texto corrigido aparecerá aqui..." class="w-full p-3 rounded-xl bg-archival-surface border border-archival-border text-xs font-philology"></textarea>
            </div>
          </div>
        </div>
      `;
    }

    function runOcrPostProcess() {
      let txt = document.getElementById('ocr-input')?.value || '';
      txt = txt
        .replace(/-\s*\n\s*/g, '')
        .replace(/s\^/g, 'š').replace(/S\^/g, 'Š')
        .replace(/h_|h,/g, 'ḫ').replace(/H_|H,/g, 'Ḫ')
        .replace(/s\./g, 'ṣ').replace(/S\./g, 'Ṣ')
        .replace(/t\./g, 'ṭ').replace(/T\./g, 'Ṭ')
        .replace(/[ \t]{2,}/g, ' ')
        .replace(/\n{3,}/g, '\n\n')
        .trim();
      const out = document.getElementById('ocr-output');
      if (out) out.value = txt;
      showToast('Pós-processamento de OCR aplicado!');
    }

