        const key = b.autor.split(',')[0].toLowerCase().replace(/[^a-z]/g, '') + b.ano;
        copyDirect(`@misc{${key},\n  author = {${b.autor}},\n  title = {${b.titulo}},\n  year = {${b.ano}},\n  howpublished = {${b.tipo} - ${b.instituicao}}\n}`, 'BibTeX copiado!');
