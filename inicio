    /* =========================================================================
       3. CONTROLADOR DE NAVEGAÇÃO (ABAS E SUBABAS)
    ========================================================================= */
    function selectMainTab(tabId, specificSubTab = null) {
      state.mainTab = tabId;
      const tabObj = NAV_STRUCTURE.find(t => t.id === tabId);
      if (tabObj && tabObj.subtabs.length > 0) {
        state.subTab = specificSubTab || tabObj.subtabs[0].id;
      } else {
        state.subTab = '';
      }
      renderNavigation();
      renderCurrentView();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function selectSubTab(subId) {
      state.subTab = subId;
      renderNavigation();
      renderCurrentView();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderNavigation() {
      const mainBar = document.getElementById('main-tabs-bar');
      mainBar.innerHTML = NAV_STRUCTURE.map(tab => {
        const active = tab.id === state.mainTab;
        return `
          <button onclick="selectMainTab('${tab.id}')"
            class="relative px-4 py-3 text-xs sm:text-[13px] font-semibold tracking-wide whitespace-nowrap transition-colors ${
              active
                ? 'text-[#FAF7F2] bg-[#3F2514]'
                : 'text-[#D4C4B0] hover:text-white hover:bg-[#3A2213]/60'
            }">
            <span>${tab.label}</span>
            ${active ? '<span class="absolute bottom-0 left-0 right-0 h-[3px] bg-[#A8763E]"></span>' : ''}
          </button>
        `;
      }).join('');

      const subWrapper = document.getElementById('subtabs-wrapper');
      const subBar = document.getElementById('subtabs-bar');
      const currentMain = NAV_STRUCTURE.find(t => t.id === state.mainTab);

      if (!currentMain || currentMain.subtabs.length === 0) {
        subWrapper.classList.add('hidden');
        subBar.innerHTML = '';
      } else {
        subWrapper.classList.remove('hidden');
        subBar.innerHTML = currentMain.subtabs.map(sub => {
          const active = sub.id === state.subTab;
          return `
            <button onclick="selectSubTab('${sub.id}')"
              class="px-3.5 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition border ${
                active
                  ? 'bg-lapis text-white border-lapis shadow-sm'
                  : 'bg-white/80 text-archival-muted border-archival-border hover:text-archival-ink hover:border-lapis/50'
              }">
              ${sub.label}
            </button>
          `;
        }).join('');
      }
    }

    function renderCurrentView() {
      const container = document.getElementById('app-content');
      if (state.mainTab === 'inicio') {
        container.innerHTML = viewInicio();
        return;
      }

      const views = {
        'mapa-fontes': viewMapaFontes,
        'ferramentas-tipografia': viewFerramentasTipografia,
        'abreviacoes': viewAbreviacoes,
        'tablete-traducao': viewTableteTraducao,
