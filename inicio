        'glossario': viewGlossario,
        'acervos': viewAcervos,
        'historia-area': viewHistoriaArea,
        'leitura-dual': viewLeituraDual,
        'anatomia': viewAnatomia,
        'dossies': viewDossies,
        'mitos-fatos': viewMitosFatos,
        'hub-bncc': viewHubBncc,
        'quem-e-quem': viewQuemEQuem,
        'laboratorios': viewLaboratorios,
        'vozes': viewVozes,
        'agenda-editais': viewAgendaEditais,
        'submissao-boletim': viewSubmissaoBoletim,
        'buscador-academico': viewBuscadorAcademico,
        'gerador-referencias': viewGeradorReferencias,
        'fichamentos': viewFichamentos,
        'ocr-pdf': viewOcrPdf,
        'sites-pesquisa': viewSitesPesquisa,
        'utilitarios-escrita': viewUtilitariosEscrita
      };

      const fn = views[state.subTab];
      container.innerHTML = fn ? fn() : viewInicio();

      if (state.subTab === 'gerador-referencias') updateRefOutputs();
      if (state.subTab === 'utilitarios-escrita') runPdfCleaner();
      if (state.subTab === 'buscador-academico' && state.academicResults.length === 0 && !state.academicLoading) {
        executeAcademicSearch(null, true);
      }
    }

