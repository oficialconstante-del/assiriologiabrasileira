        body.innerHTML = `
          <div class="p-4 rounded-xl bg-archival-surface border border-archival-border flex items-center justify-between">
            <div><span class="px-2.5 py-0.5 rounded bg-lapis text-white text-[10px] font-bold uppercase">${p.label}</span><p class="text-xs font-semibold mt-1">${state.loggedEmail}</p></div>
            <button onclick="logoutRole()" class="text-xs font-semibold text-red-800 hover:underline">Sair</button>
          </div>
          <ul class="space-y-1.5 text-xs text-archival-ink">${p.perms.map(x => `<li><strong class="text-emerald-700">&#10003;</strong> ${x}</li>`).join('')}</ul>
        `;
      }
    }
    function loginRole(k) {
      state.loggedRole = k;
      state.loggedEmail = `${k}@assiriologiabrasileira.org.br`;
      document.getElementById('header-role-pill').classList.remove('hidden');
      document.getElementById('header-role-pill').classList.add('inline-flex');
      document.getElementById('header-role-name').textContent = ROLES[k].label;
      document.getElementById('header-login-label').textContent = 'Painel Ativo';
      renderAdminModal();
      showToast(`Sessão iniciada como ${ROLES[k].label}.`);
    }
    function logoutRole() {
      state.loggedRole = null;
      document.getElementById('header-role-pill').classList.add('hidden');
      document.getElementById('header-role-pill').classList.remove('inline-flex');
      document.getElementById('header-login-label').textContent = 'Área Editorial';
      renderAdminModal();
      showToast('Sessão encerrada.');
    }

    /* =========================================================================
       11. MODAL DE CITAÇÃO, DOWNLOAD, CLIPBOARD E TOAST
    ========================================================================= */
    function openCiteModal(id) {
      const b = BIBLIOGRAPHY_DATA.find(x => x.id === id);
      if (!b) return;
      const key = b.autor.split(',')[0].toLowerCase().replace(/[^a-z]/g, '') + b.ano;
      document.getElementById('modal-abnt-text').innerHTML = `${esc(b.autor)}. <strong>${esc(b.titulo)}</strong>. ${esc(b.tipo)}. ${esc(b.instituicao)}, ${esc(b.ano)}.`;
      document.getElementById('modal-bibtex-text').textContent = `@misc{${key},\n  author = {${b.autor}},\n  title = {${b.titulo}},\n  year = {${b.ano}},\n  howpublished = {${b.tipo} - ${b.instituicao}}\n}`;
      document.getElementById('cite-modal').classList.remove('hidden');
    }
    function closeCiteModal() { document.getElementById('cite-modal').classList.add('hidden'); }

    function copyById(id, msg) {
      const el = document.getElementById(id);
      if (!el) return;
      copyDirect(el.value !== undefined ? el.value : (el.innerText || el.textContent), msg);
    }

    function copyDirect(text, msg) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      showToast(msg || 'Copiado para a área de transferência!');
    }

    function downloadBlob(content, filename, mime) {
      const blob = new Blob([content], { type: mime });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    let toastTimer = null;
    function showToast(msg) {
      const t = document.getElementById('toast');
      document.getElementById('toast-msg').textContent = msg;
      t.classList.remove('hidden');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => t.classList.add('hidden'), 3000);
    }

    /* Inicialização */
    window.addEventListener('DOMContentLoaded', () => {
      loadFichamentos();
      renderNavigation();
      renderCurrentView();
    });
  </script>
</body>
</html>
