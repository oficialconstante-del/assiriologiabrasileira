      const f = getActiveFichamento();
      const doc = `<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'><title>${esc(f.titulo)}</title></head><body>${buildFichamentoHtmlDoc(f)}</body></html>`;
