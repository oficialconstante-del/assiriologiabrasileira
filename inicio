    function runPdfCleaner() {
      const inp = document.getElementById('cl-input');
      const out = document.getElementById('cl-output');
      if (!inp || !out) return;

      let txt = inp.value.replace(/\r\n/g, '\n');
      if (document.getElementById('cl-hyphens')?.checked) txt = txt.replace(/([A-Za-zÀ-ÿ])-\n\s*([A-Za-zÀ-ÿ])/g, '$1$2');
      if (document.getElementById('cl-breaks')?.checked) {
        if (document.getElementById('cl-paras')?.checked) {
          txt = txt.replace(/\n{2,}/g, '§§PARA§§').replace(/\n/g, ' ').replace(/§§PARA§§/g, '\n\n');
        } else {
          txt = txt.replace(/\n+/g, ' ');
        }
      }
      if (document.getElementById('cl-spaces')?.checked) txt = txt.replace(/[ \t]{2,}/g, ' ').replace(/ *\n */g, '\n').trim();
      out.value = txt;

      const words = txt.trim() ? txt.trim().split(/\s+/).length : 0;
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      set('cnt-words', words);
      set('cnt-chars', txt.length);
      set('cnt-read', words === 0 ? '0 min' : `${Math.max(1, Math.ceil(words / 200))} min`);
      set('cnt-abnt', (words / 300).toFixed(1).replace('.', ','));
    }

