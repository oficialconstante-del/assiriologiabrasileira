    async function executeAcademicSearch(e, isInitialAuto = false) {
      if (e) e.preventDefault();
      const inp = document.getElementById('academic-query-input');
      const q = (inp ? inp.value : state.academicQuery).trim();
      if (!q) {
        if (!isInitialAuto) showToast('Digite um termo para pesquisar.');
        return;
      }
      state.academicQuery = q;
      state.academicLoading = true;
      state.academicStatusNote = '';
      renderAcademicResultsArea();

      const engine = state.searchEngine;
      const promises = [];

      if (engine === 'todos' || engine === 'semanticscholar') {
        promises.push(fetchSemanticScholarWorks(q));
      }
      if (engine === 'todos' || engine === 'openalex') {
        promises.push(fetchOpenAlexWorks(q));
      }
      if (engine === 'todos' || engine === 'googlescholar') {
        promises.push(fetchGoogleScholarBridgeWorks(q));
      }

      const settled = await Promise.allSettled(promises);
      let combined = [];
      let notes = [];

      settled.forEach(res => {
        if (res.status === 'fulfilled' && res.value) {
          combined = combined.concat(res.value.items || []);
          if (res.value.note) notes.push(res.value.note);
        }
      });

      const dedupMap = new Map();
      combined.forEach(item => {
        const normTitle = (item.title || '').toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 70);
        if (!normTitle) return;
        const existing = dedupMap.get(normTitle);
        if (!existing || (!existing.pdfUrl && item.pdfUrl)) {
          dedupMap.set(normTitle, item);
        }
      });

      state.academicResults = Array.from(dedupMap.values());
      state.academicStatusNote = notes.join(' · ');
      state.academicLoading = false;
      renderAcademicResultsArea();
    }

    async function fetchSemanticScholarWorks(query) {
      try {
        const url = `https://api.semanticscholar.org/graph/v1/paper/search?query=${encodeURIComponent(query)}&limit=8&fields=title,authors,year,venue,url,openAccessPdf,abstract`;
        const res = await fetch(url);
        if (!res.ok) throw new Error(`Semantic Scholar HTTP ${res.status}`);
        const data = await res.json();
        const items = (data.data || []).map(p => {
          const authorsArr = (p.authors || []).map(a => a.name).filter(Boolean);
          const pdfUrl = (p.openAccessPdf && p.openAccessPdf.url) ? p.openAccessPdf.url : '';
          return {
            source: 'Semantic Scholar',
            title: p.title || 'Sem título',
            authors: authorsArr.length ? authorsArr.join(', ') : 'Autor não informado',
            authorsList: authorsArr,
            year: p.year || 's.d.',
            venue: p.venue || 'Semantic Scholar Index',
            url: p.url || `https://www.semanticscholar.org/search?q=${encodeURIComponent(p.title || query)}`,
            pdfUrl,
            abstract: p.abstract || ''
          };
        });
        return { items, note: '' };
      } catch (err) {
        return { items: [], note: 'Semantic Scholar indisponível no momento (limite temporário da API pública)' };
      }
    }

    async function fetchOpenAlexWorks(query) {
      try {
        const url = `https://api.openalex.org/works?search=${encodeURIComponent(query)}&per-page=8`;
        const res = await fetch(url);
        if (!res.ok) throw new Error(`OpenAlex HTTP ${res.status}`);
        const data = await res.json();
        const items = (data.results || []).map(w => {
          const authorsArr = (w.authorships || []).map(a => a.author?.display_name).filter(Boolean);
          const pdfUrl =
            w.best_oa_location?.pdf_url ||
            w.primary_location?.pdf_url ||
            w.open_access?.oa_url ||
            '';
          const landingUrl =
            w.doi ||
            w.primary_location?.landing_page_url ||
            w.id ||
            `https://openalex.org/works?search=${encodeURIComponent(w.title || query)}`;
          return {
            source: 'OpenAlex',
            title: w.title || 'Sem título',
            authors: authorsArr.length ? authorsArr.join(', ') : 'Autor não informado',
            authorsList: authorsArr,
            year: w.publication_year || 's.d.',
            venue: w.primary_location?.source?.display_name || 'Repositório OpenAlex',
            url: landingUrl,
            pdfUrl,
            abstract: ''
          };
        });
        return { items, note: '' };
      } catch (err) {
        return { items: [], note: 'OpenAlex indisponível no momento' };
      }
    }

    async function fetchGoogleScholarBridgeWorks(query) {
      try {
        const url = `https://api.crossref.org/works?query=${encodeURIComponent(query)}&rows=6`;
        const res = await fetch(url);
        if (!res.ok) throw new Error(`CrossRef HTTP ${res.status}`);
        const data = await res.json();
        const items = ((data.message && data.message.items) || []).map(m => {
          const authorsArr = (m.author || []).map(a => [a.given, a.family].filter(Boolean).join(' ')).filter(Boolean);
          const title = (m.title && m.title[0]) || 'Sem título';
          const year = m.published?.['date-parts']?.[0]?.[0] || m.created?.['date-parts']?.[0]?.[0] || 's.d.';
          const venue = (m['container-title'] && m['container-title'][0]) || m.publisher || 'Google Scholar / CrossRef';
          const pdfLinkObj = (m.link || []).find(l => (l['content-type'] || '').includes('pdf'));
          const pdfUrl = pdfLinkObj ? pdfLinkObj.URL : '';
          const scholarUrl = `https://scholar.google.com/scholar?q=${encodeURIComponent(`"${title}"`)}`;
          return {
            source: 'Google Scholar',
            title,
            authors: authorsArr.length ? authorsArr.join(', ') : 'Autor não informado',
            authorsList: authorsArr,
            year,
            venue,
            url: scholarUrl,
            pdfUrl,
            abstract: ''
          };
        });
        return { items, note: '' };
      } catch (err) {
        return { items: [], note: '' };
      }
    }

    function formatAcademicResultABNT(item) {
      const formattedAuthors = (item.authorsList || []).slice(0, 3).map(name => {
        const parts = name.trim().split(/\s+/);
        if (parts.length === 1) return parts[0].toUpperCase();
        const last = parts.pop().toUpperCase();
        return `${last}, ${parts.join(' ')}`;
      }).join('; ') || 'AUTOR DESCONHECIDO';

      const accessLink = item.pdfUrl || item.url;
      const linkPart = accessLink ? ` Disponível em: <${accessLink}>.` : '';
      return `${formattedAuthors}. ${item.title}. ${item.venue}, ${item.year}.${linkPart}`;
    }

