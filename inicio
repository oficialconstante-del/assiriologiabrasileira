<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Assiriologia Brasileira — Portal de Fontes Cuneiformes, Bibliografia &amp; Pesquisa</title>

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Tipografia Editorial Acadêmica, Diacríticos Assiriológicos e Cuneiforme Unicode -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Noto+Sans+Cuneiform&family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Design Tokens: Argila Mesopotâmica, Calcário Arquivístico & Lápis-Lazúli -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            archival: {
              canvas: '#FAF7F2',       /* Pergaminho calcário claro */
              surface: '#F2ECE1',      /* Argila seca ao sol */
              stone: '#E9E0D1',        /* Pedra mesopotâmica suave */
              border: '#E2D7C5',       /* Filete de borda quente */
              borderStrong: '#CFC0A8', /* Borda acentuada */
              umber: '#3E2514',        /* Faixa fixa topo e bases escuras */
              umberDeep: '#2A180D',    /* Cabeçalho monumental */
              cream: '#F5EDE0',        /* Texto creme champanhe */
              terracotta: '#8C4327',   /* Terracota profunda */
              terracottaDark: '#6F331C',
              bronze: '#A8763E',       /* Ocre / Bronze envelhecido */
              ink: '#231C16',          /* Tinta sépia-carvão */
              muted: '#5E5146',        /* Texto secundário */
            },
            lapis: {
              DEFAULT: '#1B3B5C',      /* Azul lápis-lazúli erudito */
              hover: '#254E78',
              soft: '#EEF3F8',
            }
          },
          fontFamily: {
            display: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            monumental: ['"Cinzel"', '"Cormorant Garamond"', 'serif'],
            philology: ['"Noto Serif"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            cuneiform: ['"Noto Sans Cuneiform"', 'sans-serif'],
          },
          boxShadow: {
            editorial: '0 1px 3px rgba(35, 28, 22, 0.05), 0 8px 24px -12px rgba(35, 28, 22, 0.08)',
            elevated: '0 12px 32px -8px rgba(35, 28, 22, 0.14)',
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #FAF7F2;
      color: #231C16;
      background-image: radial-gradient(rgba(140, 67, 39, 0.035) 1px, transparent 0);
      background-size: 32px 32px;
    }

    .fade-in {
      animation: fadeEditorial 0.24s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes fadeEditorial {
      from { opacity: 0; transform: translateY(5px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Anel sutil nos pontos interativos do artefato */
    .hotspot-pulse {
      animation: hotspotRing 2.6s infinite;
    }
    @keyframes hotspotRing {
      0% { box-shadow: 0 0 0 0 rgba(140, 67, 39, 0.65); }
      70% { box-shadow: 0 0 0 11px rgba(140, 67, 39, 0); }
      100% { box-shadow: 0 0 0 0 rgba(140, 67, 39, 0); }
    }

    .map-city { cursor: pointer; }
    .map-city:hover circle { fill: #8C4327; }

    @media print {
      body * { visibility: hidden; }
      #print-fichamento-area, #print-fichamento-area * { visibility: visible; }
      #print-fichamento-area {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        padding: 24px;
        background: #ffffff;
        color: #111111;
        display: block !important;
      }
    }
  </style>
</head>
<body class="font-sans antialiased min-h-screen flex flex-col selection:bg-lapis selection:text-white overflow-x-hidden">

  <!-- =========================================================================
       CABEÇALHO MONUMENTAL ARQUITETÔNICO (FAIXA FIXA + BANNER RELEVO ETANA + ABAS)
  ========================================================================== -->
  <header class="sticky top-0 z-40 shadow-sm">
    <!-- 0. Faixa Fixa Marrom Escuro (#3E2514) com Creme Champanhe (#F5EDE0) -->
    <div role="status" aria-live="polite" class="w-full bg-[#3E2514] text-[#F5EDE0] border-b border-[#A8763E]/35 px-4 py-1.5 text-center">
      <div class="max-w-7xl mx-auto flex items-center justify-center gap-2.5 text-[11px] sm:text-xs font-semibold tracking-[0.14em] uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-[#A8763E]"></span>
        <span>SITE EM CONSTRUÇÃO — INTERFACE DE TESTE</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#A8763E]"></span>
      </div>
    </div>

    <!-- 1. Banner Arquitetônico Inspirado em ETANA & Edições Acadêmicas (Oxford / Brill) -->
    <div class="relative overflow-hidden bg-gradient-to-r from-[#2A180D] via-[#3A2213] to-[#1A2B3D] text-[#F5EDE0] border-b border-[#A8763E]/45">
      <!-- Filete superior dourado/ocre fino -->
      <div class="h-[2px] w-full bg-gradient-to-r from-transparent via-[#A8763E]/70 to-transparent"></div>

      <!-- Gravura Vetorial de Baixo-Relevo (Porta de Ištar, Alvenaria Babilônica, Zigurate & Lamassu) -->
      <svg class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none" viewBox="0 0 1440 164" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <linearGradient id="museumVignette" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#26150B" stop-opacity="0.96"/>
            <stop offset="40%" stop-color="#382112" stop-opacity="0.80"/>
            <stop offset="75%" stop-color="#2A1D15" stop-opacity="0.72"/>
            <stop offset="100%" stop-color="#17283A" stop-opacity="0.92"/>
          </linearGradient>
          <pattern id="ishtarAshlar" width="88" height="36" patternUnits="userSpaceOnUse">
            <rect x="0" y="0" width="88" height="18" fill="none" stroke="#A8763E" stroke-opacity="0.11" stroke-width="0.9"/>
            <rect x="-44" y="18" width="88" height="18" fill="none" stroke="#A8763E" stroke-opacity="0.11" stroke-width="0.9"/>
            <rect x="44" y="18" width="88" height="18" fill="none" stroke="#A8763E" stroke-opacity="0.11" stroke-width="0.9"/>
          </pattern>
        </defs>

        <!-- Alvenaria de tijolos esmaltados -->
        <rect width="1440" height="164" fill="url(#ishtarAshlar)"/>

        <!-- Friso geométrico superior e inferior (rosetas e moldura de selo cilíndrico) -->
        <line x1="0" y1="11" x2="1440" y2="11" stroke="#A8763E" stroke-opacity="0.25" stroke-width="0.8"/>
        <line x1="0" y1="153" x2="1440" y2="153" stroke="#A8763E" stroke-opacity="0.25" stroke-width="0.8"/>

        <!-- Colunas verticais de registro cuneiforme -->
        <g stroke="#A8763E" stroke-opacity="0.14" stroke-width="0.9">
          <line x1="560" y1="11" x2="560" y2="153"/>
          <line x1="665" y1="11" x2="665" y2="153"/>
          <line x1="770" y1="11" x2="770" y2="153"/>
          <line x1="1010" y1="11" x2="1010" y2="153"/>
          <line x1="1115" y1="11" x2="1115" y2="153"/>
        </g>

        <!-- Inscrições Cuneiformes Gravadas em Baixo-Relevo -->
        <g fill="#F5EDE0" fill-opacity="0.13" class="font-cuneiform">
          <text x="580" y="48" font-size="20">𒀸 𒀭 𒂗</text>
          <text x="580" y="90" font-size="20">𒆠 𒈗 𒌓</text>
          <text x="580" y="132" font-size="20">𒂍 𒅆 𒁾</text>
          <text x="684" y="52" font-size="19">𒊬 𒊒 𒌓</text>
          <text x="684" y="94" font-size="19">𒀀 𒈾 𒆠</text>
          <text x="684" y="136" font-size="19">𒋗 𒁀 𒋾</text>
          <text x="1028" y="48" font-size="20">𒀭 𒌓 𒈗</text>
          <text x="1028" y="90" font-size="20">𒆠 𒂗 𒄀</text>
          <text x="1028" y="132" font-size="20">𒁾 𒊬 𒈤</text>
        </g>

        <!-- Silhueta Arquitetônica de Zigurate + Estrela de Ištar -->
        <g transform="translate(800, 18)" fill="none" stroke="#A8763E" stroke-opacity="0.24" stroke-width="1.2">
          <rect x="12" y="102" width="166" height="22" fill="#8C4327" fill-opacity="0.12"/>
          <rect x="34" y="80" width="122" height="22" fill="#8C4327" fill-opacity="0.14"/>
          <rect x="56" y="58" width="78" height="22" fill="#1B3B5C" fill-opacity="0.20"/>
          <rect x="74" y="38" width="42" height="20" fill="#1B3B5C" fill-opacity="0.26"/>
          <line x1="95" y1="58" x2="54" y2="124"/>
          <line x1="95" y1="58" x2="136" y2="124"/>
          <g transform="translate(95, 16)" stroke="#F5EDE0" stroke-opacity="0.25">
            <circle cx="0" cy="0" r="9"/>
            <line x1="0" y1="-13" x2="0" y2="13"/>
            <line x1="-13" y1="0" x2="13" y2="0"/>
            <line x1="-9" y1="-9" x2="9" y2="9"/>
            <line x1="9" y1="-9" x2="-9" y2="9"/>
          </g>
        </g>

        <!-- Relevo Geométrico de Touro Alado (Lamassu) em Linha Fina -->
        <g transform="translate(1135, 16)" stroke="#A8763E" stroke-opacity="0.22" stroke-width="1.2" fill="#1B3B5C" fill-opacity="0.14">
          <path d="M24,78 C48,40 88,22 132,20 C112,40 96,52 76,60 C100,56 120,54 138,56 C114,70 90,78 64,82 C86,84 104,88 118,94 C90,102 56,100 24,78 Z"/>
          <circle cx="30" cy="44" r="12"/>
          <path d="M18,35 L42,35 L40,25 L20,25 Z"/>
          <path d="M20,62 L58,62 L66,124 L48,124 L44,96 L26,96 L22,124 L10,124 Z"/>
        </g>

        <rect width="1440" height="164" fill="url(#museumVignette)"/>
      </svg>

      <!-- Conteúdo Editorial do Cabeçalho -->
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <!-- Esquerda: Brasão Geométrico + Tipografia Monumental -->
        <button onclick="selectMainTab('inicio')" class="flex items-center gap-4 sm:gap-5 text-left group focus:outline-none">
          <!-- Emblema Minimalista: Cunhas Cuneiformes + Silhueta Alada / Tablete em Argila e Lápis-Lazúli -->
          <div class="w-14 h-14 sm:w-[72px] sm:h-[72px] rounded-2xl bg-[#FAF7F2]/10 p-1.5 border border-[#A8763E]/55 shadow-lg flex-shrink-0 group-hover:border-[#F5EDE0]/80 transition-all">
            <svg viewBox="0 0 84 84" class="w-full h-full" xmlns="http://www.w3.org/2000/svg" aria-label="Emblema Assiriologia Brasileira">
              <defs>
                <linearGradient id="crestTablet" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#DFB88E"/>
                  <stop offset="55%" stop-color="#A65E38"/>
                  <stop offset="100%" stop-color="#6F331C"/>
                </linearGradient>
                <linearGradient id="crestWing" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#FAF7F2"/>
                  <stop offset="100%" stop-color="#D4E0EE"/>
                </linearGradient>
              </defs>
              <!-- Tablete arquivístico -->
              <rect x="24" y="9" width="50" height="66" rx="9" fill="url(#crestTablet)" stroke="#F5EDE0" stroke-width="1.2" stroke-opacity="0.85"/>
              <line x1="31" y1="23" x2="67" y2="23" stroke="#231C16" stroke-width="1" opacity="0.55"/>
              <line x1="31" y1="61" x2="67" y2="61" stroke="#231C16" stroke-width="1" opacity="0.55"/>
              <!-- Cunhas cuneiformes -->
              <polygon points="35,14 44,16 35,18" fill="#231C16"/>
              <polygon points="49,13 51,19 53,13" fill="#231C16"/>
              <polygon points="57,14 65,16 57,18" fill="#231C16"/>
              <polygon points="47,65 56,67 47,69" fill="#231C16"/>
              <polygon points="59,64 61,70 63,64" fill="#231C16"/>
              <!-- Asa geométrica estilizada (herança ETANA) -->
              <path d="M9,48 C13,26 31,14 53,14 C45,24 37,30 27,34 C39,32 49,32 57,34 C45,42 34,46 23,48 C33,50 41,52 47,56 C34,60 17,58 9,48 Z" fill="url(#crestWing)" stroke="#1B3B5C" stroke-width="1.3"/>
              <!-- Selo Lápis-Lazúli com estrela DINGIR -->
              <circle cx="49" cy="42" r="12.5" fill="#1B3B5C" stroke="#F5EDE0" stroke-width="1.2"/>
              <g stroke="#E8C99B" stroke-width="1.6" stroke-linecap="round">
                <line x1="49" y1="34.5" x2="49" y2="49.5"/>
                <line x1="41.5" y1="42" x2="56.5" y2="42"/>
                <line x1="43.8" y1="36.8" x2="54.2" y2="47.2"/>
                <line x1="54.2" y1="36.8" x2="43.8" y2="47.2"/>
              </g>
            </svg>
          </div>

          <!-- Tipografia Monumental de Alto Contraste -->
          <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-5">
            <div>
              <span class="block text-[10px] font-semibold uppercase tracking-[0.22em] text-[#D7B384] mb-0.5">
                Humanidades Digitais · Estudos Mesopotâmicos
              </span>
              <h1 class="font-monumental text-2xl sm:text-3xl lg:text-[2.35rem] font-bold tracking-[0.06em] uppercase text-[#FAF7F2] leading-none">
                Assiriologia <span class="text-[#E5C293]">Brasileira</span>
              </h1>
            </div>
            <div class="hidden md:block w-px h-11 bg-[#A8763E]/45 flex-shrink-0"></div>
            <p class="font-display italic text-sm sm:text-base lg:text-[17px] text-[#E8DCCB] leading-snug max-w-xs">
              Repositório de Fontes Cuneiformes, Bibliografia Nacional &amp; Pesquisa
            </p>
          </div>
        </button>

        <!-- Direita: Busca Global Integrada + Acesso Editorial -->
        <div class="flex flex-wrap sm:flex-nowrap items-center gap-2.5 lg:justify-end">
          <form onsubmit="event.preventDefault(); const v = document.getElementById('banner-search-input').value.trim(); if(v){ state.academicQuery = v; selectMainTab('pesquisador', 'buscador-academico'); executeAcademicSearch(null, false); }" class="flex items-center flex-grow sm:flex-grow-0 bg-[#1B1008]/75 backdrop-blur-sm border border-[#A8763E]/45 rounded-lg overflow-hidden focus-within:border-[#E5C293] transition">
            <input id="banner-search-input" type="text" placeholder="Pesquisar fontes, artigos, siglas..." aria-label="Pesquisar no portal" class="w-full sm:w-52 lg:w-60 px-3.5 py-2 bg-transparent text-xs text-[#FAF7F2] placeholder-[#D4C5B2]/70 focus:outline-none" />
            <button type="submit" class="px-3.5 py-2 bg-[#8C4327] hover:bg-[#A35030] text-[#FAF7F2] text-xs font-semibold border-l border-[#A8763E]/35 transition" title="Buscar">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </button>
          </form>

          <span id="header-role-pill" class="hidden items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-[#8C4327] text-white text-[11px] font-semibold border border-[#A8763E]/40 whitespace-nowrap">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-300"></span>
            <span id="header-role-name">Sessão Ativa</span>
          </span>

          <button onclick="openAdminModal()" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-lapis hover:bg-lapis-hover text-white text-xs font-semibold border border-[#E5C293]/30 transition shadow-sm whitespace-nowrap">
            <svg class="w-3.5 h-3.5 text-[#E5C293]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            <span id="header-login-label">Área Editorial</span>
          </button>
        </div>
      </div>
    </div>

    <!-- 2. Barra Arquitetônica de ABAS PRINCIPAIS (Esquerda para Direita, estilo Oxford / ETANA) -->
    <nav class="bg-[#2F1B0E] border-b border-[#4D301C]" aria-label="Navegação principal">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div id="main-tabs-bar" class="flex items-center justify-start gap-1 overflow-x-auto no-scrollbar"></div>
      </div>
    </nav>

    <!-- 3. Barra Secundária de SUBABAS (Pergaminho claro, esquerda para direita) -->
    <nav id="subtabs-wrapper" class="hidden bg-archival-surface/95 backdrop-blur-md border-b border-archival-border" aria-label="Subseções">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div id="subtabs-bar" class="flex items-center justify-start gap-1.5 overflow-x-auto no-scrollbar py-2"></div>
      </div>
    </nav>
  </header>

  <!-- =========================================================================
       ÁREA PRINCIPAL DE CONTEÚDO EDITORIAL
  ========================================================================== -->
  <main id="app-content" class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10"></main>

  <!-- Container oculto para impressão de Fichamentos -->
  <div id="print-fichamento-area" class="hidden"></div>

  <!-- =========================================================================
       RODAPÉ EDITORIAL INSTITUCIONAL
  ========================================================================== -->
  <footer class="bg-[#2A180D] text-[#D8CBB8] border-t border-[#A8763E]/40 mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-b border-[#A8763E]/20">
        <div class="space-y-2.5">
          <div class="flex items-center gap-2.5">
            <span class="font-cuneiform text-xl text-[#E5C293]">𒆠𒂗𒄀</span>
            <span class="font-monumental text-base font-bold tracking-wider uppercase text-[#FAF7F2]">Assiriologia Brasileira</span>
          </div>
          <p class="text-xs text-[#C7B7A2] leading-relaxed">
            Infraestrutura acadêmica aberta dedicada à curadoria de fontes cuneiformes, catalogação da produção científica nacional, ferramentas filológicas e divulgação rigorosa sobre a antiga Mesopotâmia.
          </p>
        </div>

        <div class="space-y-2 text-xs">
          <h4 class="font-monumental text-xs font-bold uppercase tracking-widest text-[#E5C293]">Expediente &amp; Conselho Editorial</h4>
          <p class="text-[#E8DCCB] leading-relaxed">
            <strong>Coordenação e Curadoria:</strong> Cristiano Constante, Santiago Reghin, Janaína Zdebskyi e Camila.
          </p>
          <p class="text-[#B8A792]">
            Eixos: Filologia Cuneiforme, Bibliografia Nacional, Educação Básica (BNCC), Rede de Pesquisa e Ferramentas Digitais.
          </p>
        </div>

        <div class="space-y-2 text-xs">
          <h4 class="font-monumental text-xs font-bold uppercase tracking-widest text-[#E5C293]">Acesso Aberto &amp; Citabilidade</h4>
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-white/5 border border-[#A8763E]/35 text-[#FAF7F2] font-medium">
            <span>Licença Creative Commons CC BY-NC 4.0</span>
          </div>
          <p class="text-[#B8A792] leading-relaxed">
            Reprodução e uso didático autorizados mediante citação formal do portal e dos respectivos autores.
          </p>
        </div>
      </div>

      <div class="pt-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] text-[#A89782]">
        <span>© 2026 Assiriologia Brasileira · Repositório de Fontes Cuneiformes, Bibliografia Nacional &amp; Pesquisa.</span>
        <span class="font-cuneiform text-[#E5C293]/75 tracking-widest">𒀸 · 𒀭 · 𒆠 · 𒈗 · 𒌓 · 𒂍 · 𒅆</span>
      </div>
    </div>
  </footer>

  <!-- =========================================================================
       MODAL: ÁREA EDITORIAL (3 NÍVEIS DE ADMINISTRAÇÃO)
  ========================================================================== -->
  <div id="admin-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-archival-canvas rounded-2xl max-w-lg w-full border border-archival-borderStrong shadow-elevated overflow-hidden fade-in">
      <div class="bg-lapis text-white px-6 py-4 flex items-center justify-between border-b border-white/10">
        <div class="flex items-center gap-2.5">
          <span class="font-cuneiform text-[#E5C293] text-lg">𒁾</span>
          <h3 class="font-display text-2xl font-bold">Área Editorial &amp; Níveis de Acesso</h3>
        </div>
        <button onclick="closeAdminModal()" class="text-white/75 hover:text-white text-2xl leading-none px-1" aria-label="Fechar">&times;</button>
      </div>
      <div id="admin-modal-body" class="p-6 space-y-4"></div>
    </div>
  </div>

  <!-- =========================================================================
       MODAL: EXPORTAR REFERÊNCIA (ABNT & BIBTEX)
  ========================================================================== -->
  <div id="cite-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
