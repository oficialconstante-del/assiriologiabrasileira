    function updateFichField(field, val) {
      const f = getActiveFichamento();
      if (!f) return;
      f[field] = val;
      persistFichamentos();
    }
    function updateFichQuote(idx, field, val) {
      const f = getActiveFichamento();
      if (!f || !f.citacoes[idx]) return;
      f.citacoes[idx][field] = val;
      persistFichamentos();
    }
    function addFichQuote() {
      const f = getActiveFichamento();
      f.citacoes.push({ pagina: 'p. ', texto: '' });
      persistFichamentos();
      renderCurrentView();
    }
    function removeFichQuote(idx) {
      const f = getActiveFichamento();
      f.citacoes.splice(idx, 1);
      persistFichamentos();
      renderCurrentView();
    }
    function createNewFichamento() {
      const nf = { id: 'fich-' + Date.now(), titulo: 'Novo Fichamento', autor: '', ano: '2026', tipo: 'Resumo', palavras: '', referencia: '', resumo: '', citacoes: [{ pagina: 'p. ', texto: '' }], comentarios: '' };
      state.fichamentos.unshift(nf);
      state.activeFichId = nf.id;
      persistFichamentos();
      renderCurrentView();
      showToast('Novo fichamento criado!');
    }
    function deleteFichamento(id) {
      state.fichamentos = state.fichamentos.filter(f => f.id !== id);
      if (state.activeFichId === id && state.fichamentos.length > 0) state.activeFichId = state.fichamentos[0].id;
      persistFichamentos();
      renderCurrentView();
      showToast('Fichamento excluído.');
    }

    function buildFichamentoHtmlDoc(f) {
      const quotesHtml = (f.citacoes || []).filter(c => c.texto.trim()).map(c => `<p style="margin:6px 0;padding-left:12px;border-left:3px solid #8C4327;"><strong>[${esc(c.pagina)}]</strong> "${esc(c.texto)}"</p>`).join('') || '<p>Sem citações registradas.</p>';
