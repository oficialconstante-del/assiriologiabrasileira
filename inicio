    function insertDiacritic(char) {
      const ta = document.getElementById('diacritic-textbox');
      if (!ta) return;
      const start = ta.selectionStart ?? ta.value.length;
      const end = ta.selectionEnd ?? ta.value.length;
      ta.value = ta.value.slice(0, start) + char + ta.value.slice(end);
      state.diacriticDraft = ta.value;
      ta.focus();
      ta.selectionStart = ta.selectionEnd = start + char.length;
    }

